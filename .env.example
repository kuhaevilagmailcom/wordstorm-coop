# В Render добавьте ключ только через Environment, не в GitHub
PORT=3000
HCNSEC_API_BASE=https://api.hcnsec.cn/v1
HCNSEC_API_KEY=
HCNSEC_MODEL=DeepSeek-V4-Pro
HCNSEC_FALLBACK_MODEL=DeepSeek-V4-Flash
# Independent AI backup (requires its own key):
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-flash
OPENROUTER_API_KEY=
# Nginx/Cloudflare: HTTP и WebSocket должны быть включены
